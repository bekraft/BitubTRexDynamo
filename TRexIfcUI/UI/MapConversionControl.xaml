<UserControl x:Class="TRex.UI.MapConversionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=PresentationFramework"
             xmlns:local="clr-namespace:TRex.UI"
             xmlns:mscore="clr-namespace:System;assembly=mscorlib"
             xmlns:map="clr-namespace:TRex.Map"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="120" 
             d:DataContext="{d:DesignInstance map:MapConversionModel}" 
             Background="Transparent">
    
    <UserControl.Style>
        <Style>
            <Style.Triggers>
                <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="True">
                    <Setter Property="UserControl.Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
        
    <Grid MinHeight="350" MinWidth="12" Margin="3,3,3,3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Label Grid.Row="0" 
               Grid.Column="0" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               Foreground="WhiteSmoke"
               Content="EPSG ID"
               Margin="2"/>
        
        <TextBox Grid.Row="1"
                 Grid.Column="0"
                 Margin="2"
                 ToolTip="EPSG identifier"
                 TextWrapping="NoWrap"
                 Text="{Binding Path=NameOfProjectedCRS, Mode=TwoWay}"/>
        
        <Label Grid.Row="2" 
               Grid.Column="0" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               Foreground="WhiteSmoke"
               Content="Geodetic CRS"
               Margin="2"/>
        
        <TextBox Grid.Row="3"
                 Grid.Column="0"
                 ToolTip="EPSG CRS identifier"
                 Margin="2"
                 TextWrapping="NoWrap"
                 Text="{Binding Path=GeodeticDatumOfProjectedCRS, Mode=TwoWay}"/>
        
        <Label Grid.Row="4" 
               Grid.Column="0" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               Foreground="WhiteSmoke"
               Content="Length unit"
               Margin="2"/>
        
        <ComboBox x:Name="CRSTransformComboBox" 
                  Grid.Row="5" 
                  Grid.Column="0"
                  ToolTip="Referencing length unit"
                  Margin="2"
                  VerticalAlignment="Center"
                  SelectedItem="{Binding Path=MapUnitPrefixOfProjectedCRS, Mode=TwoWay}"
                  ItemsSource="{Binding Path=MapUnitScales}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding UnitPrefixName, Mode=OneWay}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="AliceBlue"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <Label Grid.Row="6" 
               Grid.Column="0" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               Foreground="WhiteSmoke"
               Content="Map projection"
               Margin="2"/>
        
        <TextBox Grid.Row="7"
                 Grid.Column="0"
                 Margin="2"
                 ToolTip="Map projection method, i.e. UTM"
                 TextWrapping="NoWrap"
                 Text="{Binding Path=MapProjectionOfProjectedCRS, Mode=TwoWay}"/>
        
        <Label Grid.Row="8" 
               Grid.Column="0" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               Foreground="WhiteSmoke"
               Content="Map zone"
               Margin="2"/>
        
        <TextBox Grid.Row="9"
                 Grid.Column="0"
                 ToolTip="Map zone of projection."
                 Margin="2"
                 TextWrapping="NoWrap"
                 Text="{Binding Path=MapZoneOfProjectedCRS, Mode=TwoWay}"/>
        
        <Label Grid.Row="10" 
               Grid.Column="0" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               Foreground="WhiteSmoke"
               Content="Vertical datum"
               Margin="2"/>
        
        <TextBox Grid.Row="11"
                 Grid.Column="0"
                 ToolTip="Vertical CRS if applicable."
                 Margin="2"
                 TextWrapping="NoWrap"
                 Text="{Binding Path=VerticalDatumOfProjectedCRS, Mode=TwoWay}"/>
        
        <CheckBox Grid.Row="12"
                  Grid.Column="0"
                  Margin="2, 10, 2, 2"
                  Foreground="WhiteSmoke"
                  ToolTip="Use local offset as map reference target"
                  Content="Use local offset"
                  IsChecked="{Binding UseLocalOffsetConversion, Mode=TwoWay}"/>

    </Grid>
</UserControl>
