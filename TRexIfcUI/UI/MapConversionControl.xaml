<UserControl x:Class="TRex.UI.MapConversionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TRex.UI"
             xmlns:mscore="clr-namespace:System;assembly=mscorlib"
             xmlns:map="clr-namespace:TRex.Map"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="120" d:DataContext="{d:DesignInstance map:MapConversionModel}" d:Background="Black">
    
    <!--
    <d:DesignerProperties.DesignStyle>
        <Style TargetType="UserControl">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Height" Value="500" />
            <Setter Property="Width" Value="500" />
        </Style>
    </d:DesignerProperties.DesignStyle>
    -->
        
    <Grid MinHeight="100" MinWidth="120" Margin="3,3,3,3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Label Grid.Row="0" 
               Grid.Column="0" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               Content="EPSG ID"
               Margin="2"/>
        
        <TextBox Grid.Row="1"
                 Grid.Column="0"
                 Margin="2"
                 TextWrapping="NoWrap"
                 Text="{Binding Path=NameOfProjectedCRS, Mode=TwoWay}"/>
        
        <Label Grid.Row="2" 
               Grid.Column="0" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               Content="Geodetic datum"
               Margin="2"/>
        
        <TextBox Grid.Row="3"
                 Grid.Column="0"
                 Margin="2"
                 TextWrapping="NoWrap"
                 Text="{Binding Path=GeodeticDatumOfProjectedCRS, Mode=TwoWay}"/>
        
        <Label Grid.Row="4" 
               Grid.Column="0" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Left"
               Content="Length unit"
               Margin="2"/>
        
        <ComboBox x:Name="CRSTransformComboBox" 
                  Grid.Row="5" 
                  Grid.Column="0"
                  Margin="2"
                  VerticalAlignment="Center"
                  SelectedItem="{Binding Path=MapUnitNameOfProjectedCRS, Mode=TwoWay}"
                  ItemsSource="{Binding Path=MapUnitNames}">
        </ComboBox>

    </Grid>
</UserControl>
